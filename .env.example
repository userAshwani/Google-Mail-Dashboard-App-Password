# Copy this file to .env and fill in your own values.
# Update MAIL_USERNAME / MAIL_PASSWORD any time you rotate the Gmail App Password.
# .env is gitignored — never commit your real credentials.
#
# Only needed if you're self-hosting with a fixed account. If you deploy this
# publicly (e.g. on Vercel), visitors can instead enter their own credentials
# on the "Profile Setup" page for temporary, in-session-only use — nothing
# typed there is ever written to disk or a database.

MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password

# App
PORT=3000
MAIL_PAGE_SIZE=50
